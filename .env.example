# Copia a apps/web/.env.local en local. En Vercel: Project → Settings → Environment Variables.
# Nada de esto va al cliente salvo las NEXT_PUBLIC_*. Nunca subas valores reales al repo.

# ── Supabase (proyecto academia-infawina, ref ozpnufodmacwqrwhndyl). Solo servidor. ──
SUPABASE_URL=https://ozpnufodmacwqrwhndyl.supabase.co
# Service role: solo la usa el servidor (lectura del catálogo, ingesta de eventos, /go). Sin ella → fallback JSON.
SUPABASE_SERVICE_ROLE_KEY=

# Para el login del panel (/panel) con los mismos usuarios del CRM
NEXT_PUBLIC_SUPABASE_URL=https://ozpnufodmacwqrwhndyl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Tracking (A4) ──
# Sal diaria del visitor_hash (se combina con la fecha). Cadena aleatoria larga: `openssl rand -hex 32`.
VISITOR_HASH_SECRET=

# ── Plataforma (A1) ──
# Token para los overrides ?__site= / ?__country= / ?__v= fuera de desarrollo (deploys de preview, QA):
#   https://<preview>.vercel.app/?__site=kronos&__country=MX&__token=<valor>
# Vacío = overrides desactivados en producción. Ponlo solo en el entorno Preview de Vercel, no en Production.
PREVIEW_OVERRIDE_TOKEN=
# Test A/B de titular y CTA (cookie `lp_v`). `false` → todos ven la variante 0 y no se escribe la cookie
# (interruptor por si compliance/AEPD exige consentimiento para cookies de A/B).
AB_TEST_ENABLED=true

# ── Compliance (A5) ──
# Gate P9: mercados con OK explícito de Sergi o su asesor. En producción, el resto muestra el fallback sin ofertas.
COMPLIANCE_APPROVED_MARKETS=
# 1 = aplicar el gate también en desarrollo (para probarlo en local).
COMPLIANCE_ENFORCE=

# ── Solo desarrollo local (no en Vercel) ──
# Carpeta de build propia para lanzar varios `next dev` en paralelo sin pisarse.
# NEXT_DIST_DIR=.next-a1
